[Unit]
Description=RubyFPV Ground Station
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/ruby
ExecStart=/home/pi/ruby/start.sh
Restart=always
StandardInput=tty
StandardOutput=tty
TTYPath=/dev/tty1
# ALSO save everything to a file
StandardError=append:/home/pi/ruby/logs/service_errors.log
StandardOutput=append:/home/pi/ruby/logs/service_output.log

[Install]
WantedBy=multi-user.target